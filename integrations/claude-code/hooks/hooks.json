{
  "description": "LockIn: file the session's summary into the notebook when it compacts, and show any open baton after.",
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "lockin",
            "tool": "capture_session",
            "input": {
              "session_id": "${session_id}",
              "summary": "${compact_summary}",
              "cwd": "${cwd}",
              "trigger": "${trigger}"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "lockin",
            "tool": "pickup_handoff",
            "input": { "cwd": "${cwd}", "peek": "true" }
          }
        ]
      }
    ]
  }
}

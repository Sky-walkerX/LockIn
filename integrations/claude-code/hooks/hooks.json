{
  "description": "LockIn: file the session into the notebook when it compacts and when it ends, and show any open baton after a compaction.",
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "lockin",
            "tool": "capture_session",
            "input": {
              "session_id": "${session_id}",
              "summary": "${compact_summary}",
              "cwd": "${cwd}",
              "trigger": "${trigger}"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "lockin",
            "tool": "pickup_handoff",
            "input": {
              "cwd": "${cwd}",
              "peek": "true"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-on-exit.sh\""
          }
        ]
      }
    ]
  }
}

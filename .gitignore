# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local uploads when files are stored on disk (lib/storage)
/storage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client, generated by `prisma generate` (part of `pnpm build`)
/app/generated/

# Visual brainstorm companion
.superpowers/

# Playwright MCP output (snapshots, console logs, screenshots)
.playwright-mcp/

# service/ (Python ingest service)
service/.venv/
service/models/
service/__pycache__/
service/**/__pycache__/
service/.pytest_cache/

# design prototypes and review captures (impeccable)
.impeccable/

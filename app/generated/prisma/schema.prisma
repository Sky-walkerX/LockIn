generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Runtime: Supabase transaction pooler (:6543, pgbouncer) — safe for serverless.
  url       = env("DATABASE_URL")
  // Migrations / db push: session pooler (:5432) — pgbouncer can't run them.
  directUrl = env("DIRECT_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ResourceType {
  LINK
  AI_CHAT
  PDF
  BOOK
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
}

// What a share link points at. Subtasks and their nested "items" are both
// Subtask rows, so one value covers both: sharing a parent exposes its items,
// sharing an item exposes just that item.
enum ShareType {
  SUBJECT
  MILESTONE
  TASK
  SUBTASK
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String? // hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects      Subject[]
  tasks         Task[]
  resources     Resource[]
  conversations Conversation[]
  noteChunks    NoteChunk[]
  shares        Share[]
}

// A public, login-free view of one record and everything beneath it. Holding
// the token is the whole authorization story: `/share/<token>` renders read-only
// and no session is consulted.
model Share {
  id        String    @id @default(uuid())
  // Unguessable and URL-safe: 16 random bytes, base64url. The only secret.
  token     String    @unique
  type      ShareType
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Polymorphic parent, like NoteChunk.sourceId: four source tables would need
  // four nullable columns to express as foreign keys. The cost is that deleting
  // a shared record leaves its Share behind, so the public loader re-resolves
  // the entity on every request and 404s when it has gone.
  entityId String

  // At most one live token per record, so re-sharing something already shared
  // hands back the existing URL instead of minting a second link to the same
  // content. Revoking deletes the row outright, so sharing again afterwards
  // mints a fresh token and the revoked URL stays dead for good.
  @@unique([type, entityId])
  @@index([userId, createdAt(sort: Desc)])
}

model Subject {
  id          String   @id @default(uuid())
  title       String
  description String?
  color       String? // optional accent color for the subject card
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  milestones    Milestone[]
  resources     Resource[]
  tasks         Task[]
  conversations Conversation[]
  noteChunks    NoteChunk[]

  // Postgres does not index foreign keys automatically; every list/detail read
  // filters on them. Composite order mirrors the query's where + orderBy.
  @@index([userId, isArchived, updatedAt(sort: Desc)])
}

model Milestone {
  id          String   @id @default(uuid())
  title       String
  notes       String   @default("") // markdown
  order       Int      @default(0) // manual ordering within a subject
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  tasks Task[]

  @@index([subjectId, order])
}

model Task {
  id            String      @id @default(uuid())
  title         String
  description   String? // markdown notes for the task
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  dueDate       DateTime?
  priority      Priority    @default(MEDIUM)
  estimatedTime Int? // estimate in minutes
  timeSpent     Int? // total actual minutes (updated on timer stop)
  recurrence    Recurrence? // null = one-off; otherwise spawns next instance on completion
  order         Int         @default(0) // manual ordering within its milestone / loose list
  createdAt     DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // A task always belongs to a subject; a milestone is optional.
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?

  subtasks      Subtask[]
  timerSessions TimerSession[]

  // Loose-task list on the subject detail (milestoneId null) and the tasks
  // nested under each milestone.
  @@index([subjectId, milestoneId, order])
  @@index([milestoneId, order])
  // Cross-subject "Today": userId + isCompleted + dueDate range, ordered by dueDate.
  @@index([userId, isCompleted, dueDate])
}

// A lightweight checklist item under a Task. Scoped to a user through its task's
// subject (no userId of its own), mirroring how Milestone is scoped.
model Subtask {
  id          String    @id @default(uuid())
  title       String
  notes       String    @default("") // markdown
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0) // manual ordering within its sibling group (taskId + parentId)
  createdAt   DateTime  @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  // Self-nesting: a subtask may sit under another subtask of the same task.
  // The UI caps depth at one level (children can't have children).
  parent   Subtask?  @relation("SubtaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children Subtask[] @relation("SubtaskChildren")

  // Top-level rows per task (parentId null), and each parent's children.
  @@index([taskId, parentId, order])
  @@index([parentId, order])
}

enum IngestState {
  NONE // never extracted — the default for every resource, forever, if nobody asks
  PENDING
  READY
  FAILED
}

model Resource {
  id        String       @id @default(uuid())
  type      ResourceType
  url       String
  title     String
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Machine-extracted markdown from the ingest service (PDF text, or the
  // article body of a LINK). Deliberately separate from `note`, which is
  // user-authored: `note` is a few sentences that change with a keystroke,
  // `extracted` can be an entire textbook. Sharing one content hash between
  // them would mean editing a one-line annotation re-embeds every page.
  extracted   String?
  pageCount   Int?
  ingestState IngestState @default(NONE)
  ingestError String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  @@index([subjectId, createdAt(sort: Desc)])
  @@index([userId])
}

model TimerSession {
  id        String    @id @default(uuid())
  startedAt DateTime
  endedAt   DateTime?
  duration  Int? // in minutes

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  @@index([taskId, startedAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

// A chat thread against the user's own local LLM. The model itself is never
// reached from the server (it lives on the user's machine) — this row and its
// messages are the durable record of an exchange the browser transported.
model Conversation {
  id        String   @id @default(uuid())
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Where the chat was opened from; drives the panel's default context scope.
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId String?

  // The context picker's selection. Plain ids rather than a join table: the
  // assembler re-reads these through a `where: { userId }` filter on every
  // turn, so foreign-key integrity would buy nothing a stale id doesn't
  // already survive.
  contextSubjectIds String[]

  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id        String   @id @default(uuid())
  role      ChatRole
  content   String
  model     String? // which local model produced it; null on user turns
  createdAt DateTime @default(now())

  // Breadcrumbs of the passages retrieved for this reply. Empty on user turns
  // and on digest-mode replies.
  sources String[]

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId, createdAt])
}

enum ChunkSource {
  SUBJECT
  MILESTONE
  TASK
  SUBTASK
  RESOURCE
  // A resource's *extracted document* (Resource.extracted), not its `note`.
  // Kept distinct from RESOURCE so a two-line annotation and an 800-chunk
  // textbook never share one content hash — see the comment on `extracted`.
  RESOURCE_DOC
}

// One embedded passage of a user's own notes. Rows are derived data: they can
// be deleted wholesale and rebuilt from the source records at any time.
model NoteChunk {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Retrieval filters by subject when the picker has a selection, and the FK
  // cascade cleans up chunks when a subject is deleted.
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  // Polymorphic parent. Not a foreign key: five source tables would need five
  // nullable columns for no gain, since a sweep already reconciles against the
  // live source set on every status check.
  source   ChunkSource
  sourceId String
  ordinal  Int

  // "Operating Systems > Memory management > Read Ch. 8". Prepended to the text
  // before embedding, and shown to the user as the citation.
  breadcrumb String
  content    String

  // sha256 of the source record's full text. Re-chunking is skipped when it
  // matches, which is what keeps indexing incremental.
  contentHash String

  // Normalised at write time, so scoring is a dot product rather than a cosine.
  embedding      Float[]
  embeddingModel String
  dims           Int

  createdAt DateTime @default(now())

  // Identifies a row within its source. Re-indexing deletes every row for a
  // source and reinserts, rather than upserting per ordinal: edited text often
  // chunks into fewer pieces than before, and upserting would leave the surplus
  // high-ordinal rows behind as stale passages that still score and still get
  // retrieved.
  @@unique([source, sourceId, ordinal])
  @@index([userId, subjectId])
  // A model change invalidates every vector; this finds them.
  @@index([userId, embeddingModel])
}

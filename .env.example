# LockIn — copy to .env and fill in. Used by docker-compose.yml.

# Required. Signs sessions and upload links. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# The address people open LockIn at (links in shares and MCP replies use it).
PUBLIC_URL=http://localhost:3000
LOCKIN_PORT=3000

# The release to run (a version such as 1.0.0). Leave empty for the one this
# checkout is.
LOCKIN_VERSION=

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=lockin

# Who can make an account: "open" (anyone who can reach this address) or
# "closed" (nobody new, once the first account exists).
SIGNUP=open

# Optional: "Continue with Google". Leave empty to sign in with email only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: outgoing email. With SMTP_HOST set, new accounts confirm their
# address from an emailed link and a forgotten password can be reset by email.
# Without it neither email exists; reset a password with scripts/set-password.sh.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender, e.g. LockIn <notebook@example.com>
SMTP_FROM=

# Optional: PDF/link text extraction and server-side embeddings.
# Run with `docker compose --profile ingest up -d` and set both:
INGEST_URL=
INGEST_SECRET=

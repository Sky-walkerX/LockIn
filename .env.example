# LockIn — copy to .env and fill in. Used by docker-compose.yml.

# Required. Signs sessions and upload links. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# The address people open LockIn at (links in shares and MCP replies use it).
PUBLIC_URL=http://localhost:3000
LOCKIN_PORT=3000
# Which of the machine's addresses that port listens on. 127.0.0.1 is the
# machine itself only: you, or a proxy running on it. 0.0.0.0 opens the port to
# the network; set TRUSTED_PROXY_HOPS=0 below with it.
LOCKIN_BIND=127.0.0.1

# The release to run (a version such as 1.0.0). Leave empty for the one this
# checkout is.
LOCKIN_VERSION=

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=lockin

# Who can make an account: "open" (anyone who can reach this address) or
# "closed" (nobody new, once the first account exists).
SIGNUP=open

# Optional: "Continue with Google". Leave empty to sign in with email only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: outgoing email. With SMTP_HOST set, new accounts confirm their
# address from an emailed link and a forgotten password can be reset by email.
# Without it neither email exists; reset a password with scripts/set-password.sh.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender, e.g. LockIn <notebook@example.com>
SMTP_FROM=

# Megabytes of images and PDFs each account may store. 0 for no ceiling.
STORAGE_QUOTA_MB=1024

# Limits on sign-in tries, sign-ups, emails and uploads. "off" drops them,
# for an instance behind something that already does this.
RATE_LIMITS=on

# How many reverse proxies stand between visitors and LockIn: 1 for Caddy or
# nginx alone, 2 with a CDN in front of that, 0 when visitors reach the port
# directly. It decides which address in X-Forwarded-For is counted as the
# visitor's; with 0 none is, since the visitor wrote the header.
TRUSTED_PROXY_HOPS=1

# Optional: PDF/link text extraction and server-side embeddings.
# Run with `docker compose --profile ingest up -d` and set both:
INGEST_URL=
INGEST_SECRET=
# How many documents the ingest service reads at once.
PARSE_CONCURRENCY=2
